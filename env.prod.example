# ============================================================
# 生产环境变量模板 · 复制为 .env.prod 并填写真实值后使用
#   cp env.prod.example .env.prod
# .env.prod 切勿提交到任何版本库
# ============================================================

# JWT 签名密钥（必须更换为强随机值）
# 生成命令（任选其一）：
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=请替换为强随机字符串

# PostgreSQL 数据库（密码用于 DATABASE_URL，请用 URL 安全字符，避免 @ / : 等分隔符）
# 建议生成：openssl rand -hex 24
POSTGRES_USER=wsms
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=workshop_safety

# 应用对外端口（服务器安全组/防火墙需放行此端口，或由 Caddy 反代）
APP_PORT=3100

# ── 知识库 / AI（可选）──
# DeepSeek API Key（OpenAI 兼容协议；留空则 AI 问答自动降级为纯语义检索）
# DeepSeek-V4 发布后把 LLM_MODEL 改成对应型号即可
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 页面新保存的 LLM API Key 使用 AES-256-GCM 加密，数据库只保存 enc:v1 密文。
# 至少 32 字节；支持 64 位 hex、32 字节 base64，或至少 32 字节的普通随机口令。
# 建议：openssl rand -base64 32
# 密钥变更后历史密文无法解密；未配置时读取历史明文仍兼容，但保存新 Key 会失败。
SETTINGS_ENCRYPTION_KEY=

# 每日备份写入命名卷 wsms-backups（容器路径 /app/backups），保留最近 30 份。
# Linux 镜像已包含 pg_dump/pg_restore；密码仅经 PGPASSWORD 传给子进程。

# 钉钉同步默认禁用。Windows 可改为 true；非 Windows 必须另配置可执行文件路径，
# 否则状态显示未配置且定时任务不会调用 cmd.exe。
DINGTALK_ENABLED=false
DINGTALK_EXECUTOR=
