# 依赖与构建产物
node_modules/
dist/
app/dist/
backend/dist/

# 环境变量与密钥（绝不入库）
.env
.env.*
*.env
!env.prod.example

# 运行时数据（生产用卷持久化，不入库）
backend/uploads/

# 本地嵌入模型（327MB 二进制，超出 git 适合范围；服务器上按部署文档下载）
backend/models/

# 厂内敏感资料（真实督查通报原件，含内部信息，不上传公开仓库）
厂督察通报/
主任系统/

# 生成物与临时资产（可由脚本重新生成）
*.pdf
intro-assets/
pdf-qa/

# 大体积安装包
*.msi

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
wsms-backup-*.dump

# 每日自动备份产物（scripts/backup.ps1 生成，含 uploads 镜像与日志，不入库）
backups/

# 钉钉通报原始文件（体积大，不入库；台账在数据库）
backend/inbox/
dingtalk-sync/
