// 车间安全管理系统 · 数据模型
// 与前端 src/types/index.ts 对齐；枚举值用小写字符串，保持 API 与前端一致

generator client {
  provider = "prisma-client-js"
  // native 覆盖开发机（Windows）；linux-musl-openssl-3.0.x 覆盖 Docker 生产镜像（node:20-alpine）
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 隐患问题（核心实体）
model Issue {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  locationId  String?
  categoryId  String?
  tagIds      String[]  @default([])
  riskLevel   String    @default("general") // general | major | critical
  status      String    @default("pending") // pending | fixing | review | closed
  /// 管理范围：managed=成品车间（走整改闭环/统计/提醒），reference=其他车间（仅存档参考）
  scope       String    @default("managed")
  source      String    @default("manual") // manual | pptx | docx | xlsx
  sourceFile  String?
  reporter    String    @default("")
  assignee    String?
  foundAt     DateTime  @default(now())
  deadline    DateTime?
  closedAt    DateTime?
  fixNote     String?
  /// 现场/整改照片路径列表（/uploads/xxx）
  photos      String[]  @default([])
  /// 防复发重复检查：间隔天数（默认 7，可编辑）
  recheckIntervalDays Int     @default(7)
  /// 要求复查次数（默认至少 3 次）
  recheckRequired    Int     @default(3)
  /// 已完成复查的时间 ISO 列表
  rechecks           String[] @default([])
  /// 责任落实（成品车间）：责任班组（控运班/机组班/加工班/职能组）
  team          String?
  /// 网格主操手
  gridOperator  String?
  /// 网格责任人（同一责任人出现 2 次及以上前端会重复提醒）
  gridOwner     String?
  /// 系统责任人
  systemOwner   String?
  /// 系统原因分析
  systemCause   String?
  /// 戴明 94/6 根因类别：system=系统原因 | individual=个人原因（null=未判定）
  causeType     String?
  /// 对策层级：mechanism=机制 | technical=技术 | management=管理（仅 causeType=system 时有意义）
  countermeasureLevel  String?
  /// 选 management 时必填：为什么机制和技术做不到
  countermeasureReason String?
  /// 整改闭环阶段：rechecking 复查中 → institutionalizing 制度沉淀 → educating 教育职工 → executing 规范执行 → done 闭环完成
  stage         String    @default("rechecking")
  /// 制度沉淀记录（制度要点）
  institutionNote String?
  /// 制度沉淀关联的知识库条目 id（可空）
  linkedKnowledgeDocId String?
  /// 回收站：删除时间（null=正常；有值=已删除可恢复，查询默认排除）
  deletedAt   DateTime?
  /// 人工复核标记：手动录入默认已复核；AI 批量识别入库的为 false，人工复核后改 true
  reviewed    Boolean  @default(true)
  /// AI 预标注（原则二：AI 只预判，不覆盖人工字段）：建议的隐患类型名（对应 tags 表 group=category，含子标签名）
  aiCategory   String?
  /// AI 建议风险等级：general | critical | immediate
  aiRiskLevel  String?
  /// AI 建议根因类别：system | individual
  aiCauseType  String?
  /// AI 整改建议（一句话）
  aiSuggestion String?
  /// 正面典型（做得好）：不计入整改闭环/超期提醒/重复考核，自动沉淀进知识库「好做法」
  isGood      Boolean  @default(false)
  /// isGood=true 时自动创建的知识库「好做法」文档 id（取消标记时随之删除）
  linkedGoodDocId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// 手工创建幂等：可空唯一键兼容历史数据与导入记录
  requestKey  String?   @unique
  requestHash String?
  issueRegulations IssueRegulation[]

  @@map("issues")
}

/// 法规制度库：国家法律 / 行政法规 / 国家标准 / 集团制度 / 厂级制度
model Regulation {
  id        String   @id @default(cuid())
  /// national_law 国家法律 | regulation 行政法规/部门规章 | gb_standard 国家标准 | group_policy 集团制度 | factory_policy 厂级制度
  category  String
  title     String
  /// 条款号（可空，关联到文件级别时为空）
  articleNo String?
  /// 内容摘要（关键内容）
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issues    IssueRegulation[]

  @@map("regulations")
}

/// 隐患-法规依据多对多关联
model IssueRegulation {
  id           String     @id @default(cuid())
  issueId      String
  issue        Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([issueId, regulationId])
  @@map("issue_regulations")
}

/// 参考件问题标注：评估其他车间问题对成品车间的参考意义（一隐患一条）
model IssueAnnotation {
  id      String @id @default(cuid())
  /// 对应隐患 id（scope=reference 的参考件；无 FK，随隐患删除由业务层清理）
  issueId String @unique
  /// 参考意义：high=需严格注意 | medium=对照自查 | low=一般了解
  relevance  String @default("medium")
  /// 成品车间的相似点（哪个区域/设备/作业与此问题类似）
  similarity String @default("")
  /// 需要严格注意的事项
  caution    String @default("")
  /// 标注的隐患类型标签 id（对应 tags 表 group=category，可空表示未归类）
  tagId      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("issue_annotations")
}

/// 标签（分维度组）
model Tag {
  id      String  @id @default(cuid())
  name    String
  group   String // category | location | custom
  color   String  @default("#007AFF")
  builtin Boolean @default(false)
  /// 子标签：指向父标签 id（仅 category 组使用；删除父标签时子标签级联删除）
  parentId String?

  @@unique([name, group])
  @@map("tags")
}

/// 周期检查计划
model InspectionPlan {
  id                  String   @id @default(cuid())
  name                String
  scope               String   @default("")
  frequency           String // daily | weekly | monthly | quarterly
  nextRunAt           DateTime
  checklist           String[] @default([])
  remindBeforeMinutes Int      @default(60)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  executions          PlanExecution[]

  @@map("inspection_plans")
}

/// 检查计划执行台账
model PlanExecution {
  id        String   @id @default(cuid())
  planId    String
  plan      InspectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  executor  String   @default("")
  note      String   @default("")
  /// 本次检查关联发现的隐患 id 列表
  issueIds  String[] @default([])
  executedAt DateTime @default(now())

  @@map("plan_executions")
}

/// 考核台账：网格责任人重复达到阈值时自动写入（周期 = 当月10日 06:00 ~ 次月10日 06:00）
model Assessment {
  id        String   @id @default(cuid())
  /// 触发的隐患 id（可空，无外键仅记 ID 字符串，隐患删除后记录保留）
  issueId   String?
  issueTitle String  @default("")
  /// 被考核人（网格责任人或整改责任人）
  owner     String
  /// 考核等级：normal=提醒 | double=加倍考核（≥3 次重复）
  level     String   @default("normal")
  /// 考核周期起止（当月10日 06:00 ~ 次月10日 06:00）
  periodStart DateTime
  periodEnd   DateTime
  note      String   @default("")
  createdAt DateTime @default(now())

  @@map("assessments")
}

/// 系统用户
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String   @default("")
  role         String   @default("safety_officer") // admin | safety_officer | viewer
  createdAt    DateTime @default(now())

  @@map("users")
}

/// 提醒记录
model Reminder {
  id        String   @id @default(cuid())
  type      String // plan | overdue | review
  refId     String
  title     String
  triggerAt DateTime
  read      Boolean  @default(false)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([type, refId])
  @@map("reminders")
}

/// AI 预标注范例（范例学习：每类取最近 3 条拼进提示词，对齐主任口径，越用越准）
model PrelabelExample {
  id           String   @id @default(cuid())
  /// 人工确认的隐患类型名（对应 tags 表 group=category）
  categoryName String
  title        String
  description  String   @default("")
  createdAt    DateTime @default(now())

  @@index([categoryName])
  @@map("prelabel_examples")
}

/// 系统设置（键值对）：LLM 配置等可在页面上修改的项，优先于环境变量
model Setting {
  key   String @id
  value String

  @@map("settings")
}

/// 知识库文档（一条隐患 / 一份通报 / 一份规程 = 一个文档）
model KnowledgeDoc {
  id        String   @id @default(cuid())
  /// 文档类型：issue=历史隐患 | annotation=参考标注 | bulletin=督查通报 | manual=规程制度
  kind      String
  /// 关联业务 id（如隐患 id），便于溯源跳转
  refId     String?
  title     String
  /// 来源说明（文件名 / 录入方式等）
  source    String   @default("")
  createdAt DateTime @default(now())
  chunks    KnowledgeChunk[]
  versions  KnowledgeDocVersion[]

  @@map("knowledge_docs")
}

/// 知识库文档历史版本：每次编辑保存前把旧内容快照存为一个版本（首次创建不存）
model KnowledgeDocVersion {
  id        String       @id @default(cuid())
  docId     String
  doc       KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  /// 递增整数版本号（从 1 开始，每篇文档独立编号）
  version   Int
  title     String
  /// 旧正文快照（chunks 按序拼接）
  content   String       @default("")
  /// 修订说明
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@unique([docId, version])
  @@map("knowledge_doc_versions")
}

/// 知识库切片：语义检索的最小单元，embedding 为 bge-large-zh 1024 维向量
model KnowledgeChunk {
  id        String   @id @default(cuid())
  docId     String
  doc       KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  seq       Int      @default(0)
  content   String
  embedding Unsupported("vector(1024)")?

  @@index([docId])
  @@map("knowledge_chunks")
}

/// 钉钉通报自动导入台账：一条群文件消息一条记录，幂等防重复导入
model DingtalkImport {
  id         String   @id @default(cuid())
  messageId  String   @unique
  fileId     String
  fileName   String
  sizeBytes  Int      @default(0)
  issueCount Int      @default(0)
  dupCount   Int      @default(0)
  status     String   @default("ok")
  error      String?
  createdAt  DateTime @default(now())

  @@map("dingtalk_imports")
}

/// 独立导入批次：idempotencyKey 是跨重试的稳定业务键，整批原子提交后才标记 succeeded
model ImportBatch {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique
  requestHash      String    @default("")
  source           String    @default("")
  externalMessageId String?
  fileHash         String?
  status           String    @default("processing")
  itemCount        Int       @default(0)
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@map("import_batches")
}

/// 批次明细：不设置 Issue 外键，避免影响既有隐患生命周期；sourceKey 为输入数组索引
model ImportItem {
  id        String  @id @default(cuid())
  batchId   String
  sourceKey String
  issueId   String
  status    String  @default("succeeded")
  error     String?

  @@unique([batchId, sourceKey])
  @@index([batchId])
  @@index([issueId])
  @@map("import_items")
}

/// 只读 Agent 的一次有界运行；业务数据只读，仅写入 Agent 自身轨迹
model AgentRun {
  id          String      @id @default(cuid())
  question    String
  status      String      @default("running") // running | succeeded | waiting_human | failed
  mode        String      @default("agent") // agent | fallback
  answer      String      @default("")
  error       String?
  createdBy   String
  createdAt   DateTime    @default(now())
  completedAt DateTime?
  steps       AgentStep[]

  @@index([createdBy, createdAt])
  @@map("agent_runs")
}

/// 模型、工具和验收步骤的统一轨迹；不保存 API Key 或完整系统提示词
model AgentStep {
  id         String   @id @default(cuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int
  kind       String // model | tool | validation
  name       String
  status     String // succeeded | failed
  input      Json
  output     Json?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([runId, seq])
  @@map("agent_steps")
}

/// 防复发复查明细；保留每次合格/不合格结论及证据
model RecheckRecord {
  id        String   @id @default(cuid())
  issueId   String
  result    String // pass | fail
  pass      Boolean
  fail      Boolean
  actor     String
  note      String   @default("")
  photos    String[] @default([])
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([issueId, checkedAt])
  @@map("recheck_records")
}

/// 核心工作流审计日志；不使用外键，彻底删除隐患后仍保留轨迹
model AuditLog {
  id        String   @id @default(cuid())
  issueId   String?
  actor     String
  action    String
  from      Json?
  to        Json?
  detail    Json?
  requestId String?
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([actor, createdAt])
  @@map("audit_logs")
}

/// 可靠副作用事件：业务事务内落库，事务后即时/定时消费
model OutboxEvent {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  type           String
  payload        Json
  status         String    @default("pending") // pending | processing | succeeded | failed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([type, status])
  @@map("outbox_events")
}
